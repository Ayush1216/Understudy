# ---- LLM (discovery only; replay never calls a model) --------------------
# Any OpenAI-compatible chat-completions endpoint with tool calling works.
# Primary: Google Gemini via AI Studio (free tier, no card). Key: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Fallback if the free tier throttles you: Groq (free, strong tool calling).
# The committed discovery evidence was recorded through this block.
# Uncomment all three; a plain KEY=VALUE parser takes the LAST assignment, so
# leaving both blocks active silently selects this one.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b

# ---- Target app credentials (demo operator; NOT real) ---------------------
# Referenced from artifacts by NAME only ({{secrets.APP_OPERATOR}}); values are read
# from the environment at substitution time and never written to any file.
APP_OPERATOR=teller1
APP_PASSWORD=password
